        <mxCell id="a1" value="创建原始需求" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="10" y="215" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a1d" value="1.必传：总需求编号、需求名称、需求类型、需求编号&lt;br&gt;2.原始业务需求：另带业务需求 ZIP 包链接&lt;br&gt;3.&lt;span style=&quot;background-color: initial;&quot;&gt;需求编号前缀可用于匹配系统 / 测试组 / 通知对象&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="185" y="190" width="390" height="59" as="geometry" />
        </mxCell>
        <mxCell id="a1x" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.2;strokeColor=#666666;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="175" y="255" as="sourcePoint" />
            <mxPoint x="600" y="255" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="b1" value="按涉及系统创建左侧目录&lt;div&gt;自动创建测试计划数据&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="555" y="204" width="190" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b1d" value="目录结构：&lt;b&gt;所属系统 &amp;gt; 总需求编号-需求名称&lt;/b&gt;&lt;br&gt;两级目录根据全流程数据自动创建；当前不强制限制人工修改&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;创建在：&lt;b&gt;所属系统 &amp;gt; 总需求编号-需求名称&lt;/b&gt; 目录下&lt;br&gt;初始状态 = &lt;b&gt;待介入&lt;/b&gt;，等待外部字段补齐&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="750" y="180" width="330" height="71" as="geometry" />
        </mxCell>
        <mxCell id="sec2" value="2. 系统子需求确认" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry y="310" width="150" height="25" as="geometry" />
        </mxCell>
        <mxCell id="sec3" value="3. 待介入 → 测试计划" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="-5" y="388.5" width="180" height="25" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="陆续补充测试计划输入" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="5" y="423.5" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a3d" value="需求规格说明书链接&lt;div&gt;开发计划完成时间&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
