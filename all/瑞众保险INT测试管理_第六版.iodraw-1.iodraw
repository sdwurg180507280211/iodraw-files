        </mxCell>
        <mxCell id="b7d" value="按最新有效计划的准备开始日期，当天 09:00 提醒：可以开始测试准备" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
