        <mxCell id="sec4" value="4. 测试计划编制" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry y="590" width="160" height="25" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="测试团队负责人编制计划" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="602.5" y="564" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b4d" value="&lt;b&gt;测试准备安排&lt;/b&gt;：人员 + 准备开始/结束时间，可多行&lt;br&gt;&lt;b&gt;测试执行安排&lt;/b&gt;：人员 + 执行开始/结束时间，可多行&lt;br&gt;准备/执行人员可不同；所有可填写项必填；冒烟测试单选&lt;br&gt;&lt;b&gt;人员排期&lt;/b&gt;：按自然日期统计占用/空闲/冲突，可导出 Excel；冲突只提示、允许保存" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="805" y="524" width="442.5" height="95" as="geometry" />
        </mxCell>
        <mxCell id="b4e" value="负责人 / 计划名称置灰；需求编号作为测试计划字段；隐藏原测试阶段下拉框" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="805" y="624" width="452.5" height="38" as="geometry" />
        </mxCell>
        <mxCell id="sec5" value="5. 计划审批" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry y="735" width="150" height="25" as="geometry" />
        </mxCell>
        <mxCell id="b5d" value="测试计划 → &lt;b&gt;待审批&lt;/b&gt;&lt;br&gt;提交后等待测试总负责人审批&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;通过：待审批 → &lt;b&gt;待测试准备&lt;/b&gt;&lt;br&gt;驳回：返回测试计划，附修改意见后重新提交&lt;br&gt;通过 / 驳回意见均可填写，非必填&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="822.5" y="699" width="275" height="115" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="测试总负责人审批" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="617.5" y="784" width="170" height="30" as="geometry" />
        </mxCell>
        <mxCell id="adj" value="计划调整（旁支）" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="230" y="755" width="150" height="25" as="geometry" />
        </mxCell>
        <mxCell id="adjd" value="原计划不覆盖；需求变化时手工基于原计划新增调整计划。&lt;br&gt;重新填写准备安排、执行安排及调整原因。&lt;br&gt;保存调整计划本身不触发人员通知；&lt;br&gt;最新计划时间 + 调整原因仍同步给全研发；后续提醒全部按最新有效计划。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="175" y="760" width="400" height="105" as="geometry" />
        </mxCell>
        <mxCell id="sec6" value="6. 测试准备" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry y="900" width="150" height="25" as="geometry" />
