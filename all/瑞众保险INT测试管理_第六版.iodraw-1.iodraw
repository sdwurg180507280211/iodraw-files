        <mxCell id="b10d" value="按最新有效计划的执行开始日期，当天 09:00 提醒；&lt;div&gt;若开发实际完成时间未提供 → 弹窗提示并禁止流转&lt;br&gt;若已提供 → 进入 &lt;b&gt;测试执行&lt;/b&gt;，记录实际执行开始时间&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="792.5" y="1304" width="472.5" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sec8" value="8. 办结" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry y="1430" width="150" height="25" as="geometry" />
        </mxCell>
        <mxCell id="b11" value="测试完成 → 报告分享" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="597.5" y="1384" width="190" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b11d" value="办结前：上传最终实际用例；最终状态只能为“通过 / 跳过”；当前计划下全部缺陷必须“已关闭”。&lt;br&gt;缺陷以测试计划为主关联，用例为可选次级关联；从用例创建缺陷时自动关联计划 + 用例。&lt;br&gt;校验通过 → 报告分享 → 记录实际执行结束时间 → &lt;b&gt;办结&lt;/b&gt;；回传全研发：状态、需求编号" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="757.5" y="1434" width="570" height="95" as="geometry" />
        </mxCell>
        <mxCell id="end" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.2;strokeColor=#666666;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="605" y="1474.09" as="sourcePoint" />
            <mxPoint x="180" y="1474.09" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="endtxt" value="办结结果回传全研发（后续流程不由测试平台设计）" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" parent="1" vertex="1">
