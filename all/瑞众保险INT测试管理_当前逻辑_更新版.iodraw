        <mxCell id="snote" value="当前状态下拉框只展示合法的下一状态；&lt;br&gt;自动流转节点不允许手工跳转；人工动作记录实际时间。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#666666;" parent="1" vertex="1">
