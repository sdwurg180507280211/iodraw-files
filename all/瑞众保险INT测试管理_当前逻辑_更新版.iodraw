        <mxCell id="a1" value="第一次触发：创建原始需求" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="10" y="215" width="180" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a1d" value="必传：总需求编号、需求名称、需求类型、需求编号&lt;br&gt;原始业务需求：另带业务需求 ZIP 包链接&lt;br&gt;一般情况下原始需求建立后，关联的所属系统就确定好了。&lt;div&gt;个别情况下需要新增关联的所属系统&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="195" y="180" width="315" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a1x" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.2;strokeColor=#666666;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="175" y="255" as="sourcePoint" />
            <mxPoint x="600" y="255" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="b1" value="按涉及系统创建左侧目录" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="555" y="215" width="190" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b1d" value="目录结构：&lt;b&gt;所属系统 &amp;gt; 总需求编号-需求名称&lt;/b&gt;&lt;br&gt;两级目录根据全流程数据自动创建；当前不强制限制人工修改&lt;br&gt;此时只建目录，不创建测试计划数据" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="750" y="200" width="300" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sec2" value="2. 系统子需求建立" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry y="315" width="150" height="25" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="第二次触发：创建系统子需求" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="5" y="350" width="190" height="30" as="geometry" />
        </mxCell>
        <mxCell id="a2d" value="传递：总需求编号、需求名称、需求编号、所属系统识别信息&lt;br&gt;需求编号作为测试计划业务字段；前缀可用于匹配系统 / 测试组 / 通知对象" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="200" y="335" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2x" value="" style="endArrow=block;endFill=1;html=1;rounded=0;strokeWidth=1.2;strokeColor=#666666;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="175" y="395" as="sourcePoint" />
            <mxPoint x="600" y="395" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="b2" value="自动创建测试计划数据" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="555" y="350" width="190" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b2d" value="创建在：&lt;b&gt;所属系统 &amp;gt; 总需求编号-需求名称&lt;/b&gt; 目录下&lt;br&gt;需求编号写入测试计划，不作为目录层级&lt;br&gt;初始状态 = &lt;b&gt;待介入&lt;/b&gt;，等待外部字段补齐" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="750" y="335" width="315" height="65" as="geometry" />
        </mxCell>
        <mxCell id="sec3" value="3. 待介入 → 测试计划" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry y="455" width="180" height="25" as="geometry" />
        </mxCell>
