        <mxCell id="a3d" value="需求规格说明书链接&lt;br&gt;开发计划完成时间" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="215" y="480" width="235" height="55" as="geometry" />
        </mxCell>
