          </mxGeometry>
        </mxCell>
        <mxCell id="b3" value="两项字段均齐全后自动流转" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="535" y="490" width="230" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b3d" value="待介入 → &lt;b&gt;测试计划&lt;/b&gt;&lt;br&gt;同时通知匹配到的测试组成员（通知具体实现待核实）" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="770" y="480" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="sec4" value="4. 测试计划编制" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry y="590" width="160" height="25" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="测试团队负责人编制计划" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="545" y="620" width="210" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b4d" value="&lt;b&gt;测试准备安排&lt;/b&gt;：人员 + 准备开始/结束时间，可多行&lt;br&gt;&lt;b&gt;测试执行安排&lt;/b&gt;：人员 + 执行开始/结束时间，可多行&lt;br&gt;准备/执行人员可不同；所有可填写项必填；冒烟测试单选&lt;br&gt;&lt;b&gt;人员排期&lt;/b&gt;：按自然日期统计占用/空闲/冲突，可导出 Excel；冲突只提示、允许保存" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="770" y="590" width="420" height="95" as="geometry" />
        </mxCell>
        <mxCell id="b4e" value="负责人 / 计划名称置灰；需求编号作为测试计划字段；隐藏原测试阶段下拉框" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="760" y="685" width="390" height="38" as="geometry" />
        </mxCell>
        <mxCell id="sec5" value="5. 计划审批" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry y="735" width="150" height="25" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="提交计划" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="575" y="750" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b5d" value="测试计划 → &lt;b&gt;待审批&lt;/b&gt;&lt;br&gt;提交后等待测试总负责人审批" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="735" y="740" width="275" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="测试总负责人审批" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="555" y="805" width="170" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b6d" value="通过：待审批 → &lt;b&gt;待测试准备&lt;/b&gt;&lt;br&gt;驳回：返回测试计划，附修改意见后重新提交&lt;br&gt;通过 / 驳回意见均可填写，非必填" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="735" y="785" width="310" height="70" as="geometry" />
        </mxCell>
        <mxCell id="adj" value="计划调整（旁支）" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="230" y="755" width="150" height="25" as="geometry" />
        </mxCell>
        <mxCell id="adjd" value="原计划不覆盖；需求变化时手工基于原计划新增调整计划。&lt;br&gt;重新填写准备安排、执行安排及调整原因。&lt;br&gt;保存调整计划本身不触发人员通知；&lt;br&gt;最新计划时间 + 调整原因仍同步给全研发；后续提醒全部按最新有效计划。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="175" y="760" width="400" height="105" as="geometry" />
        </mxCell>
        <mxCell id="sec6" value="6. 测试准备" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry y="900" width="150" height="25" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="待测试准备" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="575" y="910" width="130" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b7d" value="按最新有效计划的准备开始日期，当天 09:00 提醒：可以开始测试准备" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="725" y="900" width="320" height="45" as="geometry" />
        </mxCell>
        <mxCell id="b8" value="开始测试准备" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="565" y="965" width="150" height="30" as="geometry" />
        </mxCell>
        <mxCell id="b8d" value="人工点击后进入 &lt;b&gt;测试准备&lt;/b&gt;&lt;br&gt;记录实际准备开始时间" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
          <mxGeometry x="735" y="955" width="270" height="50" as="geometry" />
        </mxCell>
        <mxCell id="b9" value="完成测试准备" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=12;fontColor=#1F2329;" parent="1" vertex="1">
