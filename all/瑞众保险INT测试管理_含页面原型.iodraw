        <mxCell id="gw-10323" value="关联缺陷" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#0F172A;" parent="1" vertex="1">
          <mxGeometry x="788" y="840" width="624" height="18" as="geometry" />
        </mxCell>
        <mxCell id="gw-10324" value="支持从已有缺陷中搜索并关联；由于缺陷来源字段本来就存在，因此只需默认值策略，不需要新造概念。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#334155;whiteSpace=wrap;" parent="1" vertex="1">
