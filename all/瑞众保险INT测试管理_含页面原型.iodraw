          <mxGeometry x="788" y="730" width="624" height="18" as="geometry" />
        </mxCell>
        <mxCell id="gw-10321" value="保留现有缺陷创建逻辑，但自动带出：&lt;br&gt;1）缺陷来源字段；&lt;br&gt;2）需求编号/测试进度编号。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#334155;whiteSpace=wrap;" parent="1" vertex="1">
