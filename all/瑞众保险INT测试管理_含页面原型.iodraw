        </mxCell>
        <mxCell id="gw-10043" value="&lt;b&gt;提醒逻辑&lt;/b&gt;&lt;br&gt;到计划开始日 09:00 首次提醒&lt;br&gt;若未流转，每天 09:00 持续提醒&lt;br&gt;通知内可直接点按钮进入对应状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#38BDF8;align=left;verticalAlign=top;fontSize=12;" parent="1" vertex="1">
