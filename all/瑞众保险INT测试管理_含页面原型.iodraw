        <mxCell id="gw-10312" value="所有人员都“结束测试执行”后，状态列下拉框允许进入“办结”。办结前校验：用例仅能为通过/跳过，缺陷必须已关闭或已取消。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#334155;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="68" y="1076" width="624" height="86" as="geometry" />
        </mxCell>
        <mxCell id="gw-10313" value="汇报重点：测试执行同样按人员分别点击“进入 / 结束”，形成可统计的真实工时。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#64748B;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="56" y="1228" width="648" height="20" as="geometry" />
