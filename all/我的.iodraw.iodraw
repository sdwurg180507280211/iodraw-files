        <mxCell id="D9LbuRxHuZwlqRYzUCEN-12" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;(5)&lt;/span&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;指定测试团队负责人&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#ff0000&quot;&gt;(6)测试组？&lt;/font&gt;&lt;/div&gt;&lt;div&gt;(7)需求规格说明书链接&lt;/div&gt;&lt;div&gt;(8)开发计划完成时间&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
