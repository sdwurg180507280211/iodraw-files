        <mxCell id="D9LbuRxHuZwlqRYzUCEN-25" value="进入测试执行阶段&lt;div&gt;流转缺陷&lt;/div&gt;&lt;div&gt;生成测试报告&lt;/div&gt;&lt;div&gt;办结&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="WIyWlLk6GJQsqaUBKTNV-1" vertex="1">
