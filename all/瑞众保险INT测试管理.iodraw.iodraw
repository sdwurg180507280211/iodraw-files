        <mxCell id="D9LbuRxHuZwlqRYzUCEN-22" value="测试准备阶段&lt;div&gt;用例编写&lt;/div&gt;&lt;div&gt;用例评审&lt;/div&gt;&lt;div&gt;等待开发提测&lt;/div&gt;" style="edgeLabel;html=1;align=left;verticalAlign=middle;resizable=0;points=[];" parent="D9LbuRxHuZwlqRYzUCEN-3" vertex="1" connectable="0">
