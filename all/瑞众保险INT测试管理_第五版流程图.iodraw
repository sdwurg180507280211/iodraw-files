  <diagram id="INT-main-v5" name="主流程（平台交互）">
    <mxGraphModel dx="2375" dy="1289" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2350" pageHeight="1820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="瑞众保险 INT 测试管理主流程（第五版）" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#1F2329;align=center;verticalAlign=middle;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="70" y="25" width="2200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="按最新《全研发》与《瑞众保险 INT 测试管理细则第五版》整理｜需求池不参与正式流程" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#666666;align=center;verticalAlign=middle;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="70" y="82" width="2200" height="32" as="geometry" />
        </mxCell>
        <mxCell id="stage0" value="&lt;b&gt;需求已接收&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;全研发创建需求后&#xa;测试平台先建立目录&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#AAB7C4;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="70" y="125" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="stage1" value="&lt;b&gt;测试计划&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;规格说明书 + 开发计划完成时间齐备&#xa;自动创建计划并编制、审批&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#AAB7C4;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="390" y="125" width="500" height="80" as="geometry" />
        </mxCell>
        <mxCell id="stage2" value="&lt;b&gt;测试准备&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;审批通过&#xa;用例编写与评审&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#AAB7C4;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="890" y="125" width="390" height="80" as="geometry" />
        </mxCell>
        <mxCell id="stage3" value="&lt;b&gt;测试执行&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;开发实际完成&#xa;冒烟 / 用例执行 / 缺陷复测&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#AAB7C4;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1280" y="125" width="520" height="80" as="geometry" />
        </mxCell>
        <mxCell id="stage4" value="&lt;b&gt;办结&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;报告分享&#xa;同步实际结束时间、状态、报告链接&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#AAB7C4;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1800" y="125" width="480" height="80" as="geometry" />
        </mxCell>
        <mxCell id="laneL" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#D9E2EC;" parent="1" vertex="1">
          <mxGeometry x="70" y="240" width="1030" height="1490" as="geometry" />
        </mxCell>
        <mxCell id="laneR" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBFBFD;strokeColor=#D9E2EC;" parent="1" vertex="1">
          <mxGeometry x="1120" y="240" width="1160" height="1490" as="geometry" />
        </mxCell>
        <mxCell id="laneLhead" value="全研发流程平台" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEAF7;strokeColor=#86A8C5;strokeWidth=1.5;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="70" y="240" width="1030" height="55" as="geometry" />
        </mxCell>
        <mxCell id="laneRhead" value="自动化测试平台" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4EA;strokeColor=#8EBB96;strokeWidth=1.5;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1120" y="240" width="1160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="L1" value="① 创建业务需求 / 系统优化需求&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;业务需求：总需求编号、原始需求链接&lt;br&gt;系统优化：系统需求编号&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B8FF9;strokeWidth=1.5;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="130" y="330" width="860" height="100" as="geometry" />
        </mxCell>
        <mxCell id="R1" value="② 自动建立测试计划左树根目录&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;右侧测试计划暂为空&lt;br&gt;业务需求保留原始需求链接&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A663;strokeWidth=1.5;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1260" y="330" width="870" height="100" as="geometry" />
        </mxCell>
        <mxCell id="E1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" parent="1" source="L1" target="R1" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="N1" value="&lt;b&gt;系统/负责人映射&lt;/b&gt;&lt;br&gt;按需求编号简写（如 DRFS、CMS、ACRM）匹配研发平台系统、测试组和测试团队负责人。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#D6B656;fontSize=13;align=left;verticalAlign=middle;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1260" y="445" width="870" height="72" as="geometry" />
        </mxCell>
        <mxCell id="L2" value="③ 补充测试计划输入&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;《需求规格说明书》&lt;br&gt;开发计划完成时间 + 需求编号&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B8FF9;strokeWidth=1.5;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="130" y="535" width="860" height="100" as="geometry" />
        </mxCell>
        <mxCell id="R2" value="④ 两项输入均收到后，自动创建测试计划&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;阶段进入「测试计划」&lt;br&gt;并按需求编号通知对应测试团队负责人&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A663;strokeWidth=1.5;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1260" y="535" width="870" height="100" as="geometry" />
        </mxCell>
        <mxCell id="E2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" parent="1" source="L2" target="R2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="R3" value="⑤ 测试团队负责人编制测试计划&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;查看团队现有人力与并行排期&lt;br&gt;填写：计划准备开始/结束、计划执行开始/结束&lt;br&gt;为每位测试工程师分别安排时间&lt;br&gt;确认是否需要冒烟测试&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FFFA;strokeColor=#49A663;strokeWidth=1.5;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1260" y="665" width="870" height="145" as="geometry" />
        </mxCell>
        <mxCell id="E3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" parent="1" source="R2" target="R3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="R4" value="⑥ 测试总负责人在测试平台审批&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;通过：进入「测试准备」&lt;br&gt;驳回：附修改意见，退回测试团队负责人修改后重新报审&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FFFA;strokeColor=#49A663;strokeWidth=1.5;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1260" y="845" width="870" height="110" as="geometry" />
        </mxCell>
        <mxCell id="E4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" parent="1" source="R3" target="R4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="L3" value="⑦ 审批通过后接收计划信息&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;计划开始时间、计划结束时间&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B8FF9;strokeWidth=1.5;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="130" y="845" width="860" height="90" as="geometry" />
        </mxCell>
        <mxCell id="E5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" parent="1" source="R4" target="L3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="N2" value="&lt;b&gt;计划调整&lt;/b&gt;&lt;br&gt;原计划保留不覆盖；调整后向全研发新增计划开始时间、计划结束时间，并填写调整原因。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#D6B656;fontSize=13;align=left;verticalAlign=middle;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1260" y="975" width="870" height="78" as="geometry" />
        </mxCell>
        <mxCell id="R5" value="⑧ 测试准备&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;记录实际准备开始时间 → 编写测试用例 → 用例评审 → 上传评审后测试用例 → 记录实际准备结束时间&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FFFA;strokeColor=#49A663;strokeWidth=1.5;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1260" y="1080" width="870" height="105" as="geometry" />
        </mxCell>
        <mxCell id="E6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" parent="1" source="R4" target="R5" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="L4" value="⑨ 接收实际准备时间&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;实际准备开始时间 / 实际准备结束时间&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B8FF9;strokeWidth=1.5;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="130" y="1080" width="860" height="90" as="geometry" />
        </mxCell>
        <mxCell id="E7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" parent="1" source="R5" target="L4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="L5" value="⑩ 开发实际完成后推送&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;开发实际完成时间 + 需求编号&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B8FF9;strokeWidth=1.5;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="130" y="1210" width="860" height="90" as="geometry" />
        </mxCell>
        <mxCell id="R6" value="⑪ 进入「测试执行」&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;按需求编号通知负责人&lt;br&gt;记录实际执行开始时间&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#49A663;strokeWidth=1.5;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1260" y="1210" width="870" height="90" as="geometry" />
        </mxCell>
        <mxCell id="E8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" parent="1" source="L5" target="R6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="R7" value="⑫ 冒烟 / 正式用例执行 / 缺陷闭环&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;需要冒烟：优先冒烟；失败则退回开发，不继续详细测试&lt;br&gt;冒烟通过或无需冒烟：执行评审后用例&lt;br&gt;不通过/阻塞：提交缺陷 → 开发修复 → 复测&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FFFA;strokeColor=#49A663;strokeWidth=1.5;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1260" y="1335" width="870" height="135" as="geometry" />
        </mxCell>
        <mxCell id="E9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" parent="1" source="R6" target="R7" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="N3" value="&lt;b&gt;允许办结的执行结果&lt;/b&gt;&lt;br&gt;所有实际执行用例只剩「通过 / 跳过」；不得存在「未执行 / 不通过 / 阻塞」。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E7;strokeColor=#D6B656;fontSize=13;align=left;verticalAlign=middle;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1260" y="1495" width="870" height="76" as="geometry" />
        </mxCell>
        <mxCell id="R8" value="⑬ 报告统计点击分享 → INT 流程办结&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;生成/分享测试报告，通知相关人员并附报告链接&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F0FF;strokeColor=#8A6FD1;strokeWidth=1.5;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1260" y="1590" width="870" height="92" as="geometry" />
        </mxCell>
        <mxCell id="E10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" parent="1" source="R7" target="R8" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="L6" value="⑭ 接收办结结果&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#555&quot;&gt;实际执行结束时间 + 测试状态 + 报告链接&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F0FF;strokeColor=#8A6FD1;strokeWidth=1.5;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="130" y="1590" width="860" height="92" as="geometry" />
        </mxCell>
        <mxCell id="E11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;" parent="1" source="R8" target="L6" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="SL0" value="需求已接收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF3F8;strokeColor=#B4BEC8;strokeWidth=1.5;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="85" y="330" width="115" height="52" as="geometry" />
        </mxCell>
        <mxCell id="SL1" value="测试计划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#B4BEC8;strokeWidth=1.5;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="85" y="535" width="115" height="420" as="geometry" />
        </mxCell>
        <mxCell id="SL2" value="测试准备" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EF;strokeColor=#B4BEC8;strokeWidth=1.5;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="85" y="1080" width="115" height="105" as="geometry" />
        </mxCell>
        <mxCell id="SL3" value="测试执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#B4BEC8;strokeWidth=1.5;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="85" y="1210" width="115" height="360" as="geometry" />
        </mxCell>
        <mxCell id="SL4" value="办结" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#B4BEC8;strokeWidth=1.5;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="85" y="1590" width="115" height="92" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
